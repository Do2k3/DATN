@model List<TienThinhCandy.Models.InvoiceViewModel>

<!DOCTYPE html>
<html>
<head>
    <title>Hóa Đơn PDF</title>
    <style>
        body {
            width: 210mm; /* Chiều rộng chuẩn của A4 */
            height: 297mm; /* Chiều cao chuẩn của A4 */
            margin: 20mm auto; /* Canh giữa nội dung */
            padding: 10mm;
            font-family: Arial, sans-serif;
            background-color: white;
        }
        .container {
            float: right;
        }
        .tb {
            width: 100%;
            border-collapse: collapse;
        }

        .th {
            border: 1px solid black;
            padding: 8px;
            text-align: left;
        }
    </style>
</head>
<body>
    <div class="container">
        <p style="font-size: 20px ; text-align: center">Ô mai Tiến Thịnh - Một thoáng kinh kỳ</p>
        <p style="font-size: 20px ; text-align: center">21 Hàng Đường - Hoàn Kiếm - Hà Nội</p>
        <p style="font-size: 20px ; text-align: center">024 3828 2642</p>
    </div>
    <h2 style="font-size:20px ;text-align:center;">Hóa Đơn</h2>
    <p><strong>Mã đơn hàng:</strong> @Model.First().OrderCode</p>
    <p><strong>Khách hàng:</strong> @Model.First().CustomerName</p>
    <p><strong>Địa chỉ:</strong> @Model.First().Address</p>
    <p><strong>Số điện thoại:</strong> @Model.First().Phone</p>
    <p><strong>Ngày đặt:</strong> @Model.First().OrderDate.ToString("dd/MM/yyyy")</p>

    <h3>Chi tiết sản phẩm</h3>
    <table class="tb">
        <thead>
            <tr>
                <th class="th">Tên sản phẩm</th>
                <th class="th">Số lượng</th>
                <th class="th">Đơn giá</th>
                <th class="th">Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td class="th">@product.ProductName</td>
                    <td class="th">@product.Quantity</td>
                    <td class="th">@TienThinhCandy.Common.Common.FormatNumber(product.UnitPrice, 0)</td>
                    <td class="th">@TienThinhCandy.Common.Common.FormatNumber(product.TotalPrice, 0)</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td class="th" colspan="3"><strong>Tổng tiền</strong></td>
                <td class="th"><strong>@TienThinhCandy.Common.Common.FormatNumber(Model.Sum(p => p.TotalPrice), 0)</strong></td>
            </tr>
        </tfoot>
    </table>

    <h4 style="text-align:right; font-style:italic;">
        Ngày @Model.First().OrderDate.Day tháng @Model.First().OrderDate.Month năm @Model.First().OrderDate.Year
    </h4>

    <table style="width:100%; margin-top:30px; border-collapse: unset">
        <tr>
            <th style="width:50%; text-align:center;">Khách hàng</th>
            <th style="width:50%; text-align:center;">Người bán</th>
        </tr>
        <tr>
            <td style="text-align:center; padding:10px;">@Model.First().CustomerName</td>
            <td style="text-align:center; padding:10px;">Ô mai Tiến Thịnh</td>
        </tr>
    </table>


</body>
</html>
