@model  List<TienThinhCandy.Models.InvoiceViewModel>
@if (Model != null && Model.Any())
{
    <div class="row" id="exportSection">
        <div class="col-1"></div>
        <!-- Default box -->
        <div class="col-10 card" style="border: 2px solid; width:90%; height: 100%; justify-items:center">
            <div class="card-body">
                <div class="row">
                    <div class="col-6">
                        <img style="width: 120px; height: 120px; margin-left: 120px" src="~/Content/Client/img/Tienthinh.jpg" />
                    </div>
                    <div class="col-6">
                        <p style="font-size:20px">Ô mai Tiến Thịnh - Một thoáng kinh kỳ</p>
                        <p style="font-size:20px">21 Hàng Đường - Hoàn Kiếm - Hà Nội</p>
                        <p style="font-size:20px">024 3828 2642</p>
                    </div>
                </div>
                <div class="row" style="justify-content:center">
                    <h1>Hóa Đơn</h1>

                </div>
                
                    <div>
                        <p><strong>Mã đơn hàng:</strong> @Model.FirstOrDefault()?.OrderCode</p>
                        <p><strong>Khách hàng:</strong> @Model.FirstOrDefault()?.CustomerName</p>
                        <p><strong>Địa chỉ:</strong> @Model.FirstOrDefault()?.Address</p>
                        <p><strong>Số điện thoại:</strong> @Model.FirstOrDefault()?.Phone</p>
                        <p><strong>Ngày đặt:</strong> @Model.FirstOrDefault()?.OrderDate.ToString("dd/MM/yyyy")</p>
                    </div>
                    <table class="table" border="1">
                        <thead>
                            <tr>
                                <th>Tên sản phẩm</th>
                                <th>Số lượng</th>
                                <th>Đơn giá</th>
                                <th>Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model)
                            {
                                <tr>
                                    <td>@product.ProductName</td>
                                    <td>@product.Quantity</td>
                                    <td>@TienThinhCandy.Common.Common.FormatNumber(@product.UnitPrice, 0)</td>
                                    <td>@TienThinhCandy.Common.Common.FormatNumber(@product.TotalPrice, 0)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3"><strong>Tổng tiền</strong></td>
                                <td><strong>@TienThinhCandy.Common.Common.FormatNumber(Model.Sum(p => p.TotalPrice), 0)</strong></td>
                            </tr>
                        </tfoot>
                    </table>
                    <div class="row">
                        <div class="col-12">
                            <h4 class="text-lg-right" style="font-style:italic">Ngày @Model.FirstOrDefault()?.OrderDate.Day tháng @Model.FirstOrDefault()?.OrderDate.Month năm @Model.FirstOrDefault()?.OrderDate.Year</h4>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <h4 class="text-lg-center">Khách hàng</h4>
                            <div style="width: 100%; height: 100px; display: grid; place-items: center; font-size:18px ">
                                @Model.FirstOrDefault()?.CustomerName
                            </div>
                        </div>
                        <div class="col-6">
                            <h4 class="text-lg-center">Người bán</h4>
                            <div style="width: 100%; height: 100px; display: grid; place-items: center; font-size: 18px">
                                Ô mai Tiến Thịnh
                            </div>
                        </div>
                    </div>
                }

            </div>
            <div class="col-1"></div>
        </div>
    </div>
}
