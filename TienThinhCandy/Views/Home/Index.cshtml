@{
    ViewBag.Title = "Home Page";
}
@using TienThinhCandy.Controllers
<link rel="stylesheet" type="text/css" href="~/Content/assets/styles/main_styles.css">
<main>
        <!-- Slider -->
    <div class="main_slider" style="background-image: url('../../content/assets/images/slide1.jpg'); background-repeat: no-repeat; background-size: 100% 700px;">
        <div class="container fill_height">
            <div class="row align-items-end fill_height">
                <div class="col">
                    <div class="main_slider_content">
                        <h1 style="color:white">Giảm giá cho các loại hàng hàng mới </h1>
                        <div class="red_button shop_now_button"><a href="/san-pham" style="font-size:20px">Sản phẩm</a></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

        <!-- Banner -->

        @Html.Action("MenuProductCategory", "Menu")

        <!-- New Arrivals -->

        <div class="new_arrivals">
            <div class="container">
                @Html.Action("MenuArrivals", "Menu")
            </div>
        </div>


        @Html.Action("Partial_ProductSales", "Products")

        <!-- Benefit -->

        <div class="benefit">
            <div class="container">
                <div class="row benefit_row">
                    <div class="col-lg-3 benefit_col">
                        <div class="benefit_item d-flex flex-row align-items-center">
                            <div class="benefit_icon"><i class="fa fa-truck" aria-hidden="true"></i></div>
                            <div class="benefit_content">
                                <h6>Miễn phí vận chuyển</h6>
                                <p>Miễn phí vận chuyển trên toàn Hà Nội</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 benefit_col">
                        <div class="benefit_item d-flex flex-row align-items-center">
                            <div class="benefit_icon"><i class="fa fa-money" aria-hidden="true"></i></div>
                            <div class="benefit_content">
                                <h6>Thanh toán khi nhận hàng</h6>
                                <p></p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 benefit_col">
                        <div class="benefit_item d-flex flex-row align-items-center">
                            <div class="benefit_icon"><i class="fa fa-money" aria-hidden="true"></i></div>
                            <div class="benefit_content">
                                <h6>Thanh toán online</h6>
                                <p>Thực hiện thanh toán online tiện lợi</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 benefit_col">
                        <div class="benefit_item d-flex flex-row align-items-center">
                            <div class="benefit_icon"><i class="fa fa-clock-o" aria-hidden="true"></i></div>
                            <div class="benefit_content">
                                <h6>Mở cửa các ngày trong tuần</h6>
                                <p>8h sáng - 9h tối</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Blogs -->
        @Html.Action("Partial_Post_Home", "Post")
</main>